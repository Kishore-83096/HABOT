        },
        {
          "name": "Schedule For Test Date",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Schedule exposes slot status\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const slot = res.data.find(item => item.id === pm.environment.get(\"availability_id\"));",
                  "  pm.expect(slot.status).to.eql(\"AVAILABLE\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}{{api_prefix}}/lsas/{{lsa_id}}/schedule/?date={{test_date}}"
          }
        }
      ]
    },
