    {
      "name": "05 - Booking",
      "item": [
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Booking is created from fixture IDs\", function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(res.data.booking_id).to.be.a(\"string\");",
                  "  pm.expect(res.data.availability_id).to.eql(pm.environment.get(\"availability_id\"));",
                  "  pm.expect(res.data.status).to.eql(\"PAYMENT_PENDING\");",
                  "  pm.expect(res.data.payment_status).to.eql(\"INITIATED\");",
                  "});",
                  "pm.environment.set(\"booking_id\", res.data.booking_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parent_id\": \"{{parent_id}}\",\n  \"availability_id\": \"{{availability_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}{{api_prefix}}/bookings/"
          }
        },
        {
          "name": "Double Booking Is Rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Double booking fails\", function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(res.success).to.eql(false);",
                  "  pm.expect(res.errors).to.have.property(\"availability_id\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"parent_id\": \"{{parent_id}}\",\n  \"availability_id\": \"{{availability_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}{{api_prefix}}/bookings/"
          }
        }
      ]
    },
    {
      "name": "06 - Payment",
      "item": [
        {
          "name": "Process Payment Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Payment confirms booking\", function () {",
