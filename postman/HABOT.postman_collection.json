                  "  pm.expect(res.data.booking_id).to.eql(pm.environment.get(\"booking_id\"));",
                  "  pm.expect(res.data.payment_status).to.eql(\"SUCCESS\");",
                  "  pm.expect(res.data.booking_status).to.eql(\"CONFIRMED\");",
                  "  pm.expect(res.data.availability_status).to.eql(\"BOOKED\");",
                  "});",
                  "pm.environment.set(\"payment_id\", res.data.payment_id);"
                ]
