          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_id\": \"{{booking_id}}\",\n  \"result\": \"success\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}{{api_prefix}}/payments/process/"
          }
        },
        {
          "name": "Webhook Idempotency",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Terminal payment webhook is idempotent\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(res.data.payment_id).to.eql(pm.environment.get(\"payment_id\"));",
                  "  pm.expect(res.data.payment_status).to.eql(\"SUCCESS\");",
                  "  pm.expect(res.data.booking_status).to.eql(\"CONFIRMED\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"booking_id\": \"{{booking_id}}\",\n  \"result\": \"failed\",\n  \"gateway_reference\": \"postman-idempotency-check\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}{{api_prefix}}/payments/webhook/"
          }
        }
      ]
