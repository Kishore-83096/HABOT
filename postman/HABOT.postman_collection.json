  "item": [
    {
      "name": "00 - Environment & Health",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Health succeeds\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(res.success).to.eql(true);",
                  "  pm.expect(res.data.database).to.eql(\"connected\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health/"
          }
        }
      ]
    },
    {
      "name": "01 - Test Data Setup",
      "item": [
        {
          "name": "Bootstrap Test Run",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const guid = pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\");",
                  "pm.environment.set(\"test_run_id\", `POSTMAN_TEST_${Date.now()}_${guid}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const data = res.data || {};",
                  "pm.test(\"Bootstrap succeeded\", function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "  pm.expect(res.success).to.eql(true);",
                  "  pm.expect(data.test_run_id).to.eql(pm.environment.get(\"test_run_id\"));",
                  "  pm.expect(data.parent.id).to.be.a(\"string\");",
                  "  pm.expect(data.lsa.id).to.be.a(\"string\");",
                  "  pm.expect(data.skills).to.be.an(\"array\").that.is.not.empty;",
                  "  pm.expect(data.lsa_skills).to.be.an(\"array\").that.is.not.empty;",
                  "  pm.expect(data.availability).to.be.an(\"array\").with.length.greaterThan(1);",
                  "});",
                  "pm.environment.set(\"admin_id\", data.admin.id);",
                  "pm.environment.set(\"admin_username\", data.admin.username);",
                  "pm.environment.set(\"parent_id\", data.parent.id);",
                  "pm.environment.set(\"lsa_id\", data.lsa.id);",
                  "pm.environment.set(\"skill_id\", data.skills[0].id);",
                  "pm.environment.set(\"skill_name\", data.skills[0].name);",
                  "pm.environment.set(\"lsa_skill_id\", data.lsa_skills[0].id);",
                  "pm.environment.set(\"availability_id\", data.availability[0].id);",
                  "pm.environment.set(\"availability_id_2\", data.availability[1].id);",
                  "pm.environment.set(\"test_date\", data.availability[0].date);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"test_run_id\": \"{{test_run_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}{{api_prefix}}/test-data/bootstrap/"
          }
        }
      ]
    },
    {
      "name": "02 - LSA Discovery",
      "item": [
        {
          "name": "Search LSAs By Dynamic Skill",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Generated LSA is discoverable by skill\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const ids = res.data.map(item => item.id);",
                  "  pm.expect(ids).to.include(pm.environment.get(\"lsa_id\"));",
                  "  const lsa = res.data.find(item => item.id === pm.environment.get(\"lsa_id\"));",
                  "  pm.expect(lsa.skills).to.include(pm.environment.get(\"skill_name\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}{{api_prefix}}/lsas/search/?skill={{skill_name}}"
          }
        },
        {
          "name": "Search LSAs By Dynamic Availability Date",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Generated LSA is discoverable by date\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(res.data.map(item => item.id)).to.include(pm.environment.get(\"lsa_id\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}{{api_prefix}}/lsas/search/?available_date={{test_date}}"
          }
        },
        {
          "name": "LSA Detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"LSA detail matches fixture\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(res.data.id).to.eql(pm.environment.get(\"lsa_id\"));",
                  "  pm.expect(res.data.skills).to.include(pm.environment.get(\"skill_name\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}{{api_prefix}}/lsas/{{lsa_id}}/"
          }
        }
      ]
    },
    {
      "name": "03 - LSA Availability",
      "item": [
        {
          "name": "Available Slots",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Fixture availability is visible\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(res.data.map(slot => slot.id)).to.include(pm.environment.get(\"availability_id\"));",
                  "});"
